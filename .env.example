# Cascada de archivos .env (mayor a menor precedencia): variables reales de
# process.env (Docker env_file, CI, shell) > .env.<NODE_ENV>.local > .env.local
# > .env.<NODE_ENV> > .env. Una key de archivo solo se aplica si todavia no
# esta seteada en process.env.
# Bajo NODE_ENV=test se leen UNICAMENTE .env.test.local y .env.test.
# Todas las keys son opcionales: hay defaults en src/configs/env.config.ts
# (salvo API_URL, que es obligatoria).

# Server
PORT=5050
NODE_ENV=development
BASE_URL=
SEED_DEFAULT_DATA=false

# Logging (fatal | error | warn | info | debug | trace | silent)
LOG_LEVEL=info

# JSON / urlencoded body size limit (e.g. 100kb, 1mb, 1gb)
BODY_LIMIT=1gb

# Redirect
API_URL=https://jsonplaceholder.typicode.com

# Upstream HTTP client
HTTP_TIMEOUT_MS=5000

# Rate limit (sobre /graphql)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Dev tooling — por defecto se activan sólo si NODE_ENV != "production"
GRAPHIQL_ENABLED=true
GRAPHQL_INTROSPECTION=true

# Hot Reload docker
CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=100
